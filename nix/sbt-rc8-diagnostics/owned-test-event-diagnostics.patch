index 0000000..57f0275
--- /dev/null
+++ b/main-actions/src/test/java/sbt/internal/worker1/DiagnosticEvents.java
@@ -0,0 +1,34 @@
+package sbt.internal.worker1;
+
+import java.util.ArrayList;
+import sbt.testing.*;
+
+/** Uses the real worker event conversion and codec, without starting a worker. */
+public final class DiagnosticEvents {
+  private DiagnosticEvents() {}
+
+  public static String batch(long id, String group, int successes, int failures) {
+    ArrayList<ForkTestMain.ForkEvent> events = new ArrayList<>();
+    for (int i = 0; i < successes + failures; i++) {
+      final Status status = i < failures ? Status.Failure : Status.Success;
+      final String selector = "synthetic-selector-" + i;
+      events.add(new ForkTestMain.ForkEvent(new Event() {
+        public String fullyQualifiedName() { return group; }
+        public Fingerprint fingerprint() {
+          return new SubclassFingerprint() {
+            public boolean isModule() { return false; }
+            public String superclassName() { return "synthetic.Marker"; }
+            public boolean requireNoArgConstructor() { return true; }
+          };
+        }
+        public Selector selector() { return new TestSelector(selector); }
+        public Status status() { return status; }
+        public OptionalThrowable throwable() { return new OptionalThrowable(); }
+        public long duration() { return 0L; }
+      }));
+    }
+    ForkTestMain.ForkEventsInfo info = new ForkTestMain.ForkEventsInfo(id, group, events);
+    return "{\"jsonrpc\":\"2.0\",\"method\":\"testEvents\",\"params\":"
+      + WorkerMain.mkGson().toJson(info, info.getClass()) + "}";
+  }
+}
diff --git a/main-actions/src/test/scala/sbt/ForkTestsDiagnosticsTest.scala b/main-actions/src/test/scala/sbt/ForkTestsDiagnosticsTest.scala
new file mode 100644
index 0000000..e93c16e
--- /dev/null
+++ b/main-actions/src/test/scala/sbt/ForkTestsDiagnosticsTest.scala
@@ -0,0 +1,170 @@
+package sbt
+
+import java.util.concurrent.{ CountDownLatch, TimeUnit }
+import java.util.concurrent.atomic.AtomicReference
+import scala.collection.mutable
+import scala.sys.process.Process
+import sbt.internal.{ WorkerExchange, WorkerResponseListener, WorkerTestDiagnostics }
+import sbt.internal.worker1.DiagnosticEvents
+import sbt.protocol.testing.TestResult
+import sbt.util.{ Level, Logger }
+
+/** Diagnostic regression witnesses; normal-provider integration remains a separate obligation. */
+object ForkTestsDiagnosticsTest extends verify.BasicTestSuite:
+  private val request = 41L
+  private val group = "private.synthetic.Group"
+  private val response = s"""{"jsonrpc":"2.0","id":$request,"result":0}"""
+
+  private class RecordingLogger extends Logger:
+    val lines = mutable.ArrayBuffer.empty[String]
+    def trace(error: => Throwable): Unit = ()
+    def success(message: => String): Unit = ()
+    def log(level: Level.Value, message: => String): Unit = lines.synchronized { lines += message; () }
+    def diagnostics: Vector[String] = lines.synchronized {
+      lines.iterator.filter(_.startsWith("[sbt-fork-test]")).toVector
+    }
+
+  private class OwnedProcess extends Process:
+    @volatile var alive = true
+    def isAlive(): Boolean = alive
+    def exitValue(): Int = 0
+    def destroy(): Unit = alive = false
+
+  private def fixture(listeners: Seq[TestReportListener] = Nil) =
+    val logger = new RecordingLogger
+    val process = new OwnedProcess
+    val results = mutable.Map.empty[String, SuiteResult]
+    val react = new React(request, logger, listeners, results, process)
+    (react, logger, process, results)
+
+  test("one 113-event failure batch retains exact normal counts and completion") {
+    val (react, logger, _, results) = fixture()
+    react(DiagnosticEvents.batch(request, group, 112, 1))
+    react(response)
+    assert(results(group).passedCount == 112)
+    assert(results(group).failureCount == 1)
+    assert(results(group).result == TestResult.Failed)
+    assert(react.promise.future.value.exists(_.get == 0)) // Existing transport acknowledgement.
+    assert(logger.diagnostics.exists(line => line.contains("stage=events.decoded") && line.contains("events=113") && line.contains("Failure=1")))
+    assert(!logger.diagnostics.exists(_.contains(group)))
+    assert(!logger.diagnostics.exists(_.contains("synthetic-selector")))
+  }
+
+  test("all-pass batch and valid empty batch preserve existing results") {
+    val (passing, _, _, results) = fixture()
+    passing(DiagnosticEvents.batch(request, group, 113, 0))
+    passing(response)
+    assert(results(group).passedCount == 113)
+    assert(results(group).result == TestResult.Passed)
+    val (empty, logger, _, emptyResults) = fixture()
+    empty(DiagnosticEvents.batch(request, group, 0, 0))
+    empty(response)
+    assert(emptyResults(group).passedCount == 0)
+    assert(emptyResults(group).failureCount == 0)
+    assert(emptyResults(group).result == TestResult.Passed)
+    assert(empty.promise.future.value.exists(_.get == 0))
+    assert(logger.diagnostics.exists(_.contains("events=0")))
+  }
+
+  test("owned decode error is attributed without changing the existing completion policy") {
+    val (react, logger, _, results) = fixture()
+    react(s"""{"method":"testEvents","params":{"id":$request,"group":"secret","events":null}}""")
+    assert(results.isEmpty)
+    assert(!react.promise.isCompleted)
+    assert(logger.diagnostics.exists(line => line.contains("stage=exception") && line.contains("phase=events.decode") && line.contains("owner=owned")))
+    react(response)
+    assert(react.promise.future.value.exists(_.get == 0)) // Diagnostic-only: not a failure-propagation fix.
+  }
+
+  test("owned listener exception records its phase without exporting the exception message") {
+    val badListener = new TestReportListener:
+      def startGroup(name: String): Unit = ()
+      def testEvent(event: TestEvent): Unit = throw new IllegalStateException("private exception sentinel")
+      def endGroup(name: String, error: Throwable): Unit = ()
+      def endGroup(name: String, result: TestResult): Unit = ()
+    val (react, logger, _, results) = fixture(Seq(badListener))
+    react(DiagnosticEvents.batch(request, group, 112, 1))
+    assert(results.isEmpty)
+    assert(logger.diagnostics.exists(line => line.contains("stage=exception") && line.contains("phase=listener.testEvent") && line.contains("index=0")))
+    assert(!logger.diagnostics.exists(_.contains("private exception sentinel")))
+    react(response)
+    assert(react.promise.future.value.exists(_.get == 0))
+  }
+
+  test("foreign ID cannot mutate owned results or complete the request") {
+    val (react, logger, _, results) = fixture()
+    react(DiagnosticEvents.batch(request + 1, group, 0, 1))
+    react(s"""{"id":${request + 1},"result":0}""")
+    assert(results.isEmpty)
+    assert(!react.promise.isCompleted)
+    assert(logger.diagnostics.exists(_.contains("owner=foreign")))
+    react(response)
+    assert(react.promise.future.value.exists(_.get == 0))
+  }
+
+  test("controlled dispatch delay exposes exit-before-receipt without repairing the race") {
+    val (react, logger, process, results) = fixture()
+    val entered = new CountDownLatch(1)
+    val release = new CountDownLatch(1)
+    val failure = new AtomicReference[Throwable]()
+    val blocker = new WorkerResponseListener:
+      def notifyExit(p: Process): Unit = ()
+      def apply(line: String): Unit =
+        entered.countDown()
+        if !release.await(5, TimeUnit.SECONDS) then throw new IllegalStateException("fixture release timed out")
+    WorkerExchange.registerListener(blocker)
+    WorkerExchange.registerListener(react)
+    val reader = new Thread(() => {
+      try WorkerExchange.notifyListeners(DiagnosticEvents.batch(request, group, 112, 1))
+      catch case error: Throwable => failure.set(error)
+    })
+    try
+      reader.start()
+      assert(entered.await(5, TimeUnit.SECONDS))
+      process.alive = false
+      react.notifyExit(process)
+      assert(react.promise.future.value.exists(_.get == 0))
+      react.snapshot("snapshot.before-release")
+      assert(results.isEmpty)
+      release.countDown()
+      reader.join(5000)
+      assert(!reader.isAlive)
+      assert(failure.get() == null)
+      assert(results(group).failureCount == 1)
+      val rows = logger.diagnostics
+      val snapshot = rows.indexWhere(_.contains("stage=snapshot.before-release"))
+      val received = rows.indexWhere(_.contains("stage=events.received"))
+      assert(snapshot >= 0 && received > snapshot)
+    finally
+      release.countDown()
+      reader.join(5000)
+      WorkerExchange.unregisterListener(react)
+      WorkerExchange.unregisterListener(blocker)
+  }
+
+  test("diagnostics are bounded and a broken observer cannot change aggregation") {
+    val lines = mutable.ArrayBuffer.empty[String]
+    val trace = new WorkerTestDiagnostics.Trace(line => { lines += line; () })
+    (0 until WorkerTestDiagnostics.maxRecords + 10).foreach(_ => trace.record("fixture"))
+    assert(lines.size == WorkerTestDiagnostics.maxRecords + 1)
+    assert(lines.last.contains("stage=truncated"))
+    val broken = new WorkerTestDiagnostics.Trace(_ => throw new IllegalStateException("sink"))
+    broken.record("fixture")
+    val results = mutable.Map.empty[String, SuiteResult]
+    val brokenLogger = new RecordingLogger:
+      override def log(level: Level.Value, message: => String): Unit =
+        throw new IllegalStateException("observer sink")
+    val react = new React(request, brokenLogger, Nil, results, new OwnedProcess)
+    react(DiagnosticEvents.batch(request, group, 112, 1))
+    assert(results(group).failureCount == 1)
+  }
+
+  test("adjacent same-group overwrite is observed and remains outside this repair") {
+    val (react, logger, _, results) = fixture()
+    react(DiagnosticEvents.batch(request, group, 0, 1))
+    react(DiagnosticEvents.batch(request, group, 1, 0))
+    assert(results(group).passedCount == 1)
+    assert(results(group).failureCount == 0) // Preserve RC8 replacement; no presumed merge fix.
+    assert(logger.diagnostics.exists(line => line.contains("stage=aggregate.before") && line.contains("failed=1")))
+  }
+end ForkTestsDiagnosticsTest
