+// Metadata only. It observes existing ordering and never coordinates test completion.
+private[sbt] object WorkerTestDiagnostics:
+  private val sequence = new AtomicLong()
+  private val scopes = new AtomicLong()
+  val maxRecords = 256
+  val maxCountedEvents = 4096
+  val unscoped = new Trace(_ => ())
+
+  def identity(value: AnyRef): String =
+    Integer.toUnsignedString(System.identityHashCode(value))
+
+  def hash(value: String): String =
+    if value == null then "null"
+    else
+      val bytes = MessageDigest.getInstance("SHA-256").digest(value.getBytes(StandardCharsets.UTF_8))
+      java.util.HexFormat.of().formatHex(bytes)
+
+  final class Trace(write: String => Unit):
+    private val scope = scopes.incrementAndGet()
+    private val records = new AtomicInteger()
+
+    def record(stage: String, fields: => String = ""): Unit =
+      try
+        val index = records.getAndIncrement()
+        if index <= maxRecords then
+          val actualStage = if index == maxRecords then "truncated" else stage
+          val details = if index == maxRecords then "" else fields
+          val serial = sequence.incrementAndGet()
+          write(s"[sbt-fork-test] seq=$serial scope=$scope stage=$actualStage $details")
+      catch
+        case NonFatal(_) => () // Observation cannot change the existing result.
