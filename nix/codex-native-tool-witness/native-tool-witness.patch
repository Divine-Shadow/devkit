+#[test]
+fn unsupported_invalid_and_over_limit_evidence_is_unavailable_not_empty() {
+    for (tools, reason) in [
+        (
+            json!([{"type":"future_unknown", "private":PRIVATE}]),
+            "unsupported_declaration_shape",
+        ),
+        (
+            json!([{"type":"function", "name":"private\nidentifier"}]),
+            "invalid_identifier",
+        ),
+        (
+            json!(
+                (0..=MAX_NAMES)
+                    .map(|i| json!({"type":"function", "name":format!("tool_{i}")}))
+                    .collect::<Vec<_>>()
+            ),
+            "declaration_count_exceeded",
+        ),
+        (
+            json!([{"type":"function", "name":"safe", "description":"x".repeat(MAX_RAW_DECLARATION_BYTES)}]),
+            "declaration_bytes_exceeded",
+        ),
+    ] {
+        let tools = serde_json::value::to_raw_value(&tools).unwrap();
+        assert_eq!(
+            inventory(Some(&tools), &[]),
+            Inventory::Unavailable { reason }
+        );
+    }
+}
