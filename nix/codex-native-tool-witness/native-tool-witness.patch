+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::io::Write;
+use std::sync::Arc;
+use std::sync::Mutex;
+
+const TURN_ID: &str = "01a10f05-5521-7180-839f-aab11b85fe26";
+const PRIVATE: &str = "PRIVATE_PROMPT_SCHEMA_HEADER_RESPONSE_SENTINEL";
+
+fn fixture() -> (ThreadId, CodexResponsesMetadata, ResponsesApiRequest) {
+    let thread_id = ThreadId::from_string(SUBJECT_THREAD_ID).unwrap();
+    let mut metadata = CodexResponsesMetadata::new(
+        "installation".into(),
+        "session".into(),
+        SUBJECT_THREAD_ID.into(),
+        "window".into(),
+    );
+    metadata.turn_id = Some(TURN_ID.into());
+    metadata.request_kind = Some(CodexResponsesRequestKind::Turn);
+    let declarations = vec![json!({
+        "type": "namespace", "name": "governance", "description": PRIVATE,
+        "tools": [{"type": "function", "name": "workspace_topology", "description": PRIVATE,
+                   "parameters": {"type": "object", "properties": {"private": {"description": PRIVATE}}}}]
+    })];
+    let request = ResponsesApiRequest {
+        model: "gpt-6.1-sol".into(),
+        instructions: PRIVATE.into(),
+        input: vec![
+            ResponseItem::AdditionalTools {
+                id: None,
+                role: "developer".into(),
+                tools: declarations,
+            },
+            serde_json::from_value(json!({"type": "message", "role": "user",
+                "content": [{"type": "input_text", "text": PRIVATE}]}))
+            .unwrap(),
+        ],
+        tools: None,
+        tool_choice: "auto".into(),
+        parallel_tool_calls: true,
+        reasoning: None,
+        store: false,
+        stream: true,
+        stream_options: None,
+        include: vec![],
+        service_tier: None,
+        prompt_cache_key: Some(PRIVATE.into()),
+        text: None,
+        client_metadata: Some(std::collections::HashMap::from([(
+            "private".into(),
+            PRIVATE.into(),
+        )])),
+        access_programs: None,
+    };
+    (thread_id, metadata, request)
+}
+
+#[derive(Clone)]
+struct Capture(Arc<Mutex<Vec<u8>>>);
+
+impl Write for Capture {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        self.0.lock().unwrap().extend_from_slice(bytes);
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+fn capture(run: impl FnOnce()) -> String {
+    let output = Arc::new(Mutex::new(Vec::new()));
+    let writer = Capture(Arc::clone(&output));
+    let subscriber = tracing_subscriber::fmt()
+        .with_ansi(false)
+        .without_time()
+        .with_max_level(tracing::Level::INFO)
+        .with_writer(move || writer.clone())
+        .finish();
+    tracing::subscriber::with_default(subscriber, run);
+    String::from_utf8(output.lock().unwrap().clone()).unwrap()
+}
+
+#[test]
+fn http_emits_names_only_and_preserves_the_entire_request() {
+    let (thread_id, metadata, request) = fixture();
+    let before = serde_json::to_value(&request).unwrap();
+    let output = capture(|| record_http(&thread_id, &metadata, &request));
+    assert_eq!(serde_json::to_value(&request).unwrap(), before);
+    let inventory = Inventory::Available {
+        names: vec!["governance".into(), "governance.workspace_topology".into()],
+        additional_tools_sets: 1,
+    };
+    let expected = serde_json::to_string(&inventory).unwrap();
+    assert!(output.contains(&format!("logical={expected}")));
+    assert!(output.contains(&format!("transmitted={expected}")));
+    assert!(output.contains("phase=\"prepared_outbound\""));
+    assert!(!output.contains(PRIVATE));
+}
+
+#[test]
+fn incremental_websocket_keeps_complete_names_separate_from_empty_delta() {
+    let (thread_id, metadata, request) = fixture();
+    let wire = ResponsesWsRequest::ResponseCreate(ResponseCreateWsRequest {
+        previous_response_id: Some(PRIVATE.into()),
+        input: &[],
+        ..ResponseCreateWsRequest::from(&request)
+    });
+    let before = (
+        serde_json::to_value(&request).unwrap(),
+        serde_json::to_value(&wire).unwrap(),
+    );
+    let output = capture(|| record_websocket(&thread_id, &metadata, &request, &wire));
+    assert_eq!(
+        (
+            serde_json::to_value(&request).unwrap(),
+            serde_json::to_value(&wire).unwrap()
+        ),
+        before
+    );
+    assert!(output.contains("governance.workspace_topology"));
+    assert!(output.contains(
+        "transmitted={\"status\":\"available\",\"names\":[],\"additional_tools_sets\":0}"
+    ));
+    assert!(output.contains("inherits_previous_response=true"));
+    assert!(!output.contains(PRIVATE));
+}
+
+#[test]
+fn spoofed_metadata_other_threads_and_non_turn_requests_emit_nothing() {
+    let (thread_id, mut metadata, request) = fixture();
+    let other_thread = ThreadId::from_string("01a10e3b-02ea-7af2-be04-ed9fb904b29e").unwrap();
+    assert_eq!(
+        capture(|| record_http(&other_thread, &metadata, &request)),
+        ""
+    );
+    for kind in [
+        None,
+        Some(CodexResponsesRequestKind::Memory),
+        Some(CodexResponsesRequestKind::Prewarm),
+    ] {
+        metadata.request_kind = kind;
+        assert_eq!(capture(|| record_http(&thread_id, &metadata, &request)), "");
+    }
+    metadata.request_kind = Some(CodexResponsesRequestKind::Turn);
+    for id in [None, Some(PRIVATE.into()), Some(String::new())] {
+        metadata.turn_id = id;
+        assert_eq!(capture(|| record_http(&thread_id, &metadata, &request)), "");
+    }
+}
