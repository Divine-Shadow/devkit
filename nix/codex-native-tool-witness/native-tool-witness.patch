+#[test]
+fn duplicate_entry_budget_is_shared_across_top_level_and_additional_tools() {
+    let declaration = json!({"type":"function", "name":"safe"});
+    let top_level = serde_json::value::to_raw_value(&vec![declaration.clone(); MAX_NAMES]).unwrap();
+    let mut input = vec![ResponseItem::AdditionalTools {
+        id: None,
+        role: "developer".into(),
+        tools: vec![declaration.clone(); MAX_NAMES],
+    }];
+    assert_eq!(
+        inventory(Some(&top_level), &input),
+        Inventory::Available {
+            names: vec!["safe".into()],
+            additional_tools_sets: 1,
+        }
+    );
+    input.push(ResponseItem::AdditionalTools {
+        id: None,
+        role: "developer".into(),
+        tools: vec![declaration],
+    });
+    assert_eq!(
+        inventory(Some(&top_level), &input),
+        Inventory::Unavailable {
+            reason: "declaration_entries_exceeded",
+        }
+    );
+}
+
+#[test]
+fn namespace_children_also_consume_the_shared_duplicate_entry_budget() {
+    let namespace = json!({"type":"namespace", "name":"functions",
+        "tools":vec![json!({"type":"function", "name":"safe"}); MAX_NAMES]});
+    let input = vec![ResponseItem::AdditionalTools {
+        id: None,
+        role: "developer".into(),
+        tools: vec![namespace.clone(), namespace],
+    }];
+    assert_eq!(
+        inventory(None, &input),
+        Inventory::Unavailable {
+            reason: "declaration_entries_exceeded",
+        }
+    );
+}
