+//! Temporary, exact-subject declaration evidence for the retained TC01 consumer.
+//!
+//! This records prepared requests, never provider receipt. It reads only lowered tool
+//! declarations and emits bounded identifiers; prompts, schemas and headers are excluded.
+
+use codex_api::ResponseCreateWsRequest;
+use codex_api::ResponsesApiRequest;
+use codex_api::ResponsesWsRequest;
+use codex_protocol::ThreadId;
+use codex_protocol::models::ResponseItem;
+use serde::Serialize;
+use serde_json::Value;
+use serde_json::value::RawValue;
+use std::collections::BTreeSet;
+
+use crate::responses_metadata::CodexResponsesMetadata;
+use crate::responses_metadata::CodexResponsesRequestKind;
+
+const SUBJECT_THREAD_ID: &str = "01a107d7-4be2-71e3-91c3-299ad135b69d";
+const MAX_NAMES: usize = 128;
+const MAX_DECLARATION_ENTRIES: usize = 256;
+const MAX_NAME_BYTES: usize = 128;
+const MAX_RAW_DECLARATION_BYTES: usize = 1024 * 1024;
+
+#[derive(Debug, PartialEq, Serialize)]
+#[serde(tag = "status", rename_all = "snake_case")]
+enum Inventory {
+    Available {
+        names: Vec<String>,
+        additional_tools_sets: usize,
+    },
+    Unavailable {
+        reason: &'static str,
+    },
+}
+
+pub(super) fn record_http(
+    thread_id: &ThreadId,
+    metadata: &CodexResponsesMetadata,
+    request: &ResponsesApiRequest,
+) {
+    let Some(turn_id) = subject_turn(thread_id, metadata) else {
+        return;
+    };
+    let view = ResponseCreateWsRequest::from(request);
+    let names = inventory(view.tools, view.input);
+    emit(
+        turn_id, "http", &names, &names, /*inherits_previous_response*/ false,
+    );
+}
+
+pub(super) fn record_websocket(
+    thread_id: &ThreadId,
+    metadata: &CodexResponsesMetadata,
+    request: &ResponsesApiRequest,
+    wire_request: &ResponsesWsRequest<'_>,
+) {
+    let Some(turn_id) = subject_turn(thread_id, metadata) else {
+        return;
+    };
+    let logical = ResponseCreateWsRequest::from(request);
+    let ResponsesWsRequest::ResponseCreate(wire) = wire_request;
+    // A delta can omit AdditionalTools already sent in prewarm or an earlier request.
+    // Preserve the complete logical inventory separately; an empty delta is not absence.
+    emit(
+        turn_id,
+        "websocket",
+        &inventory(logical.tools, logical.input),
+        &inventory(wire.tools, wire.input),
+        wire.previous_response_id.is_some(),
+    );
+}
+
+fn subject_turn<'a>(thread_id: &ThreadId, metadata: &'a CodexResponsesMetadata) -> Option<&'a str> {
+    if thread_id.to_string() != SUBJECT_THREAD_ID
+        || !matches!(metadata.request_kind, Some(CodexResponsesRequestKind::Turn))
+    {
+        return None;
+    }
+    metadata
+        .turn_id
+        .as_deref()
+        .filter(|id| id.len() == 36 && uuid::Uuid::try_parse(id).is_ok())
+}
+
+fn emit(
+    turn_id: &str,
+    transport: &'static str,
+    logical: &Inventory,
+    transmitted: &Inventory,
+    inherits_previous_response: bool,
+) {
+    let unavailable =
+        || r#"{"status":"unavailable","reason":"projection_serialization_failed"}"#.to_owned();
+    let logical = serde_json::to_string(logical).unwrap_or_else(|_| unavailable());
+    let transmitted = serde_json::to_string(transmitted).unwrap_or_else(|_| unavailable());
+    tracing::info!(
+        target: "codex_core::native_tool_witness",
+        thread_id = SUBJECT_THREAD_ID,
+        turn_id,
+        phase = "prepared_outbound",
+        transport,
+        logical = %logical,
+        transmitted = %transmitted,
+        inherits_previous_response,
+        "native declaration witness"
+    );
+}
+
+fn inventory(tools: Option<&RawValue>, input: &[ResponseItem]) -> Inventory {
+    let mut names = BTreeSet::new();
+    let mut additional_tools_sets = 0;
+    let mut remaining_entries = MAX_DECLARATION_ENTRIES;
+    let result = (|| {
+        if let Some(tools) = tools {
+            if tools.get().len() > MAX_RAW_DECLARATION_BYTES {
+                return Err("declaration_bytes_exceeded");
+            }
+            let tools: Value =
+                serde_json::from_str(tools.get()).map_err(|_| "invalid_declaration_json")?;
+            let tools = tools.as_array().ok_or("unsupported_declaration_shape")?;
+            if tools.len() > MAX_NAMES {
+                return Err("declaration_count_exceeded");
+            }
+            for tool in tools {
+                append_tool(tool, &mut names, &mut remaining_entries)?;
+            }
+        }
+        for item in input {
+            if let ResponseItem::AdditionalTools { tools, .. } = item {
+                additional_tools_sets += 1;
+                if additional_tools_sets > MAX_NAMES || tools.len() > MAX_NAMES {
+                    return Err("declaration_count_exceeded");
+                }
+                for tool in tools {
+                    append_tool(tool, &mut names, &mut remaining_entries)?;
+                }
+            }
+        }
+        Ok(())
+    })();
+    match result {
+        Ok(()) => Inventory::Available {
+            names: names.into_iter().collect(),
+            additional_tools_sets,
+        },
+        Err(reason) => Inventory::Unavailable { reason },
+    }
+}
+
+fn append_tool(
+    tool: &Value,
+    names: &mut BTreeSet<String>,
+    remaining_entries: &mut usize,
+) -> Result<(), &'static str> {
+    *remaining_entries = remaining_entries
+        .checked_sub(1)
+        .ok_or("declaration_entries_exceeded")?;
+    match tool.get("type").and_then(Value::as_str) {
+        Some("function" | "custom") => insert_name(tool.get("name"), names),
+        Some("namespace") => {
+            let namespace = valid_name(tool.get("name"))?;
+            insert_name(tool.get("name"), names)?;
+            let tools = tool
+                .get("tools")
+                .and_then(Value::as_array)
+                .ok_or("unsupported_declaration_shape")?;
+            if tools.len() > MAX_NAMES {
+                return Err("declaration_count_exceeded");
+            }
+            for tool in tools {
+                *remaining_entries = remaining_entries
+                    .checked_sub(1)
+                    .ok_or("declaration_entries_exceeded")?;
+                if !matches!(
+                    tool.get("type").and_then(Value::as_str),
+                    Some("function" | "custom")
+                ) {
+                    return Err("unsupported_declaration_shape");
+                }
+                let name = valid_name(tool.get("name"))?;
+                insert_name(Some(&Value::String(format!("{namespace}.{name}"))), names)?;
+            }
+            Ok(())
+        }
+        Some("tool_search") => insert_name(Some(&Value::String("tool_search".to_owned())), names),
+        Some("web_search") => insert_name(Some(&Value::String("web_search".to_owned())), names),
+        _ => Err("unsupported_declaration_shape"),
+    }
+}
+
+fn valid_name(value: Option<&Value>) -> Result<&str, &'static str> {
+    let name = value.and_then(Value::as_str).ok_or("invalid_identifier")?;
+    if name.is_empty()
+        || name.len() > MAX_NAME_BYTES
+        || !name
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'.' | b'-'))
+    {
+        return Err("invalid_identifier");
+    }
+    Ok(name)
+}
+
+fn insert_name(value: Option<&Value>, names: &mut BTreeSet<String>) -> Result<(), &'static str> {
+    names.insert(valid_name(value)?.to_owned());
+    if names.len() > MAX_NAMES {
+        return Err("declaration_count_exceeded");
+    }
+    Ok(())
+}
