+#[test]
+fn native_serializers_project_function_custom_namespace_and_hosted_names() {
+    use codex_tools::*;
+    use std::collections::BTreeMap;
+    let function = |name: &str| ResponsesApiTool {
+        name: name.into(),
+        description: PRIVATE.into(),
+        strict: false,
+        defer_loading: None,
+        parameters: JsonSchema::object(
+            BTreeMap::new(),
+            /*required*/ None,
+            /*additional_properties*/ None,
+        ),
+        output_schema: None,
+    };
+    let tools = vec![
+        ToolSpec::Function(function("lookup")),
+        ToolSpec::Namespace(ResponsesApiNamespace {
+            name: "governance".into(),
+            description: PRIVATE.into(),
+            tools: vec![ResponsesApiNamespaceTool::Function(function(
+                "workspace_topology",
+            ))],
+        }),
+        ToolSpec::Freeform(FreeformTool {
+            name: "exec".into(),
+            description: PRIVATE.into(),
+            defer_loading: None,
+            format: FreeformToolFormat {
+                r#type: "grammar".into(),
+                syntax: "lark".into(),
+                definition: PRIVATE.into(),
+            },
+        }),
+        ToolSpec::ToolSearch {
+            execution: "client".into(),
+            description: PRIVATE.into(),
+            parameters: JsonSchema::object(
+                BTreeMap::new(),
+                /*required*/ None,
+                /*additional_properties*/ None,
+            ),
+        },
+        ToolSpec::WebSearch {
+            external_web_access: None,
+            indexed_web_access: None,
+            filters: None,
+            user_location: None,
+            search_context_size: None,
+            search_content_types: None,
+        },
+    ];
+    let names = vec![
+        "exec",
+        "governance",
+        "governance.workspace_topology",
+        "lookup",
+        "tool_search",
+        "web_search",
+    ];
+    let raw = create_tools_raw_json_for_responses_api(&tools).unwrap();
+    assert_eq!(
+        inventory(Some(&raw), &[]),
+        Inventory::Available {
+            names: names.iter().map(|name| (*name).into()).collect(),
+            additional_tools_sets: 0,
+        }
+    );
+    let standard = vec![ResponseItem::AdditionalTools {
+        id: None,
+        role: "developer".into(),
+        tools: create_tools_json_for_responses_api(&tools).unwrap(),
+    }];
+    assert_eq!(
+        inventory(None, &standard),
+        Inventory::Available {
+            names: names.into_iter().map(str::to_owned).collect(),
+            additional_tools_sets: 1,
+        }
+    );
+    let lite = vec![ResponseItem::AdditionalTools {
+        id: None,
+        role: "developer".into(),
+        tools: create_tools_json_for_responses_lite(&tools).unwrap(),
+    }];
+    assert_eq!(
+        inventory(None, &lite),
+        Inventory::Available {
+            names: vec![
+                "functions",
+                "functions.exec",
+                "functions.lookup",
+                "governance",
+                "governance.workspace_topology",
+                "tool_search",
+                "web_search"
+            ]
+            .into_iter()
+            .map(str::to_owned)
+            .collect(),
+            additional_tools_sets: 1,
+        }
+    );
+}
