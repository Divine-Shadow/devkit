#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
DEVKIT_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd -P)"
DEV_ROOT="$(cd -- "$DEVKIT_ROOT/.." && pwd -P)"
DEVKIT="$DEVKIT_ROOT/kit/scripts/devkit"

runtime_codex_version_for() {
  local overlay="$1"
  local yaml="$DEVKIT_ROOT/overlays/$overlay/devkit.yaml"
  awk '
    /^[[:space:]]*runtime:[[:space:]]*$/ { in_runtime = 1; next }
    /^[^[:space:]][^:]*:/ { if (in_runtime) exit }
    in_runtime && /^[[:space:]]+codex_version:[[:space:]]*/ {
      sub(/^[[:space:]]+codex_version:[[:space:]]*/, "")
      sub(/[[:space:]]+#.*$/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      if (substr($0, 1, 1) == "\"" && substr($0, length($0), 1) == "\"") {
        $0 = substr($0, 2, length($0) - 2)
      }
      print
      exit
    }
  ' "$yaml"
}

REPO="${DEVKIT_NATIVE_READINESS_REPO:-ouroboros-ide}"
DEV_ALL_FLAKE="${DEVKIT_NATIVE_READINESS_DEV_ALL_FLAKE:-./overlays/dev-all#default}"
EXPECTED_CODEX_VERSION="${DEVKIT_NATIVE_READINESS_CODEX_VERSION:-$(runtime_codex_version_for dev-all)}"
CODEX_MODEL="${DEVKIT_NATIVE_READINESS_CODEX_MODEL:-gpt-5.5}"
CODEX_PROMPT="${DEVKIT_NATIVE_READINESS_CODEX_PROMPT:-reply with exactly 'ok'}"
GOVERNANCE_JAR_RESOLVER="${DEVKIT_NATIVE_READINESS_GOVERNANCE_JAR_RESOLVER:-$DEV_ROOT/ouroboros-ide/scripts/devops/resolve-pinned-jar}"
GOVERNANCE_JAR="${DEVKIT_NATIVE_READINESS_GOVERNANCE_JAR:-}"
BACKEND_MAIN="${DEVKIT_NATIVE_READINESS_BACKEND_MAIN:-com.crib.bills.ouroboros.apps.StartWebServerInMemoryLocal}"

fail() {
  echo "native-readiness-audit: $*" >&2
  exit 1
}

step() {
  printf '\n== %s ==\n' "$*"
}

grep_required() {
  local pattern="$1"
  local file="$2"
  grep -q -- "$pattern" "$file" || fail "missing expected pattern $pattern in $file"
}

resolve_governance_jar() {
  if [[ -n "$GOVERNANCE_JAR" ]]; then
    case "$GOVERNANCE_JAR" in
      /nix/store/*/share/subagent-governance/subagent-governance.jar|*/target/pinned-jars/*/subagent-governance.jar) ;;
      *) fail "DEVKIT_NATIVE_READINESS_GOVERNANCE_JAR must be a Nix-store or pinned governance jar, got: $GOVERNANCE_JAR" ;;
    esac
    test -s "$GOVERNANCE_JAR" || fail "governance jar does not exist: $GOVERNANCE_JAR"
    return 0
  fi

  [[ -x "$GOVERNANCE_JAR_RESOLVER" ]] || fail "published governance jar resolver missing: $GOVERNANCE_JAR_RESOLVER"
  GOVERNANCE_JAR="$("$GOVERNANCE_JAR_RESOLVER" --runtime subagent-governance)"
  case "$GOVERNANCE_JAR" in
    */target/pinned-jars/*/subagent-governance.jar) ;;
    *) fail "resolved governance jar is not a pinned governance jar: $GOVERNANCE_JAR" ;;
  esac
  test -s "$GOVERNANCE_JAR" || fail "resolved governance jar does not exist: $GOVERNANCE_JAR"
}

wait_for_socket() {
  local socket="$1"
  local pid="$2"
  local log="$3"
  for _ in $(seq 1 50); do
    [[ -S "$socket" ]] && return 0
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      cat "$log" >&2 || true
      fail "process $pid exited before creating $socket"
    fi
    sleep 0.1
  done
  cat "$log" >&2 || true
  fail "timed out waiting for $socket"
}

generated_zshrc_files() {
  shopt -s nullglob
  local files=(
    "$DEV_ROOT"/.devhomes/*/.zshrc
    "$DEV_ROOT"/agent-worktrees/*/.devhome*/.zshrc
    "$DEV_ROOT"/agent-worktrees/*/.devhomes/*/.zshrc
    "$DEV_ROOT"/.devkit/native-agents/*/home/.zshrc
  )
  ((${#files[@]} > 0)) || return 0
  printf '%s\0' "${files[@]}"
}

guard_native_shells() {
  local retired_bin="/usr/local/bin/""codex"
  local retired_wrapper="codex""w"
  local source_guard_files=(
    "$DEVKIT_ROOT/cli/devctl/internal/seed/seed.go"
    "$DEVKIT_ROOT/cli/devctl/internal/agentexec/agentexec.go"
    "$DEVKIT_ROOT/cli/devctl/internal/runtime/launch/launch.go"
    "$DEVKIT_ROOT/cli/devctl/internal/commands/nativecmd/native.go"
  )
  if grep -nE "$retired_bin|$retired_wrapper" "${source_guard_files[@]}"; then
    fail "native shell sources contain stale Codex image path assumptions"
  fi

  if generated_zshrc_files | xargs -0 -r grep -nE "$retired_bin|$retired_wrapper"; then
    fail "live generated zshrc contains stale Codex image path assumptions"
  fi
  return 0
}

audit_dir="$(mktemp -d /tmp/devkit-native-readiness.XXXXXX)"
broker_sock="$audit_dir/broker.sock"
broker_state="$audit_dir/broker-state"
egress_sock="$audit_dir/egress.sock"
egress_log="$audit_dir/egress.log"
egress_pid=""

cleanup() {
  set +e
  if [[ -n "$egress_pid" ]]; then
    kill "$egress_pid" >/dev/null 2>&1 || true
  fi
  "$DEVKIT" -p dev-all down --repo "$REPO" --count 2 \
    --flake "$DEV_ALL_FLAKE" \
    --broker-socket "$broker_sock" \
    --broker-state-root "$broker_state" \
    --format json >/dev/null 2>&1 || true
  rm -rf "$audit_dir"
}
trap cleanup EXIT

step "resolve governance jar from flake"
resolve_governance_jar
printf 'governance_jar=%s\n' "$GOVERNANCE_JAR"

step "native generated shell static guard"
guard_native_shells

step "start native egress proxy"
"$DEVKIT" -p dev-all native egress-proxy \
  --socket "$egress_sock" \
  --allowlist "$DEVKIT_ROOT/kit/proxy/allowlist.txt" \
  >"$egress_log" 2>&1 &
egress_pid=$!
wait_for_socket "$egress_sock" "$egress_pid" "$egress_log"

step "launch two native ouroboros agents"
"$DEVKIT" -p dev-all up --repo "$REPO" --count 2 \
  --flake "$DEV_ALL_FLAKE" \
  --broker-socket "$broker_sock" \
  --broker-state-root "$broker_state" \
  --skip-ready --format json \
  | tee "$audit_dir/up.json"
grep_required '"runtime": "native"' "$audit_dir/up.json"
grep_required '"count": 2' "$audit_dir/up.json"
grep_required '"running": true' "$audit_dir/up.json"

step "confirm two-agent native status"
"$DEVKIT" -p dev-all status --repo "$REPO" --count 2 \
  --flake "$DEV_ALL_FLAKE" \
  --broker-socket "$broker_sock" \
  --broker-state-root "$broker_state" \
  --format json \
  | tee "$audit_dir/status.json"
grep_required '"command": "status"' "$audit_dir/status.json"
grep_required '"count": 2' "$audit_dir/status.json"
grep_required '"running": true' "$audit_dir/status.json"

read -r -d '' egress_exec <<'EOF' || true
set -euo pipefail
test "${DEVKIT_NATIVE_AGENT:-}" = 1
test "${HTTP_PROXY:-}" = "http://127.0.0.1:18888"
test "${HTTPS_PROXY:-}" = "http://127.0.0.1:18888"

allowed_connect="$(curl -k -sS -o /tmp/devkit-egress-allowed.out -w "%{http_connect}" --connect-timeout 10 --max-time 20 https://api.openai.com || true)"
echo "allowed_connect=$allowed_connect"
test "$allowed_connect" = 200

blocked_connect="$(curl -k -sS -o /tmp/devkit-egress-blocked.out -w "%{http_connect}" --connect-timeout 10 --max-time 20 https://blocked.invalid || true)"
echo "blocked_connect=$blocked_connect"
test "$blocked_connect" = 403

direct_status="$(
  env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy \
    curl -k -sS -o /tmp/devkit-egress-direct.out -w "%{http_code}" --connect-timeout 3 --max-time 6 https://blocked.invalid || true
)"
echo "direct_status=$direct_status"
test "$direct_status" = 000

echo "native-egress-policy-ok"
EOF

step "egress allow-list enforcement"
"$DEVKIT" -p dev-all exec 1 --repo "$REPO" --flake "$DEV_ALL_FLAKE" \
  --broker-socket "$broker_sock" --proxy-socket "$egress_sock" -- \
  bash -lc "$egress_exec" \
  2>&1 | tee "$audit_dir/egress.txt"
grep_required "allowed_connect=200" "$audit_dir/egress.txt"
grep_required "blocked_connect=403" "$audit_dir/egress.txt"
grep_required "direct_status=000" "$audit_dir/egress.txt"
grep_required "native-egress-policy-ok" "$audit_dir/egress.txt"

read -r -d '' governance_exec <<'EOF' || true
set -euo pipefail
idx="${DEVKIT_NATIVE_AUDIT_AGENT_INDEX:?}"
port=$((17880 + idx))
workspace_id="devkit-audit-agent${idx}"
state_dir="/tmp/devkit-governance-audit-agent${idx}"
attestation="/tmp/devkit-governance-audit-agent${idx}.attestation"
repo_config="/tmp/devkit-missing-repo-config-agent${idx}.json"

rm -rf "$state_dir"
mkdir -p "$state_dir"
printf 'devkit native readiness audit fallback for agent %s\n' "$idx" > "$attestation"

export SUBAGENT_GOVERNANCE_CONTROL_PLANE_BIND=127.0.0.1
export SUBAGENT_GOVERNANCE_CONTROL_PLANE_PORT="$port"
export SUBAGENT_GOVERNANCE_CONTROL_PLANE_URL="http://127.0.0.1:${port}"
export SUBAGENT_GOVERNANCE_CONTROL_PLANE_STATE_DIR="$state_dir"
export SUBAGENT_GOVERNANCE_CONTROL_PLANE_FALLBACK_ATTESTATION="$attestation"
export SUBAGENT_GOVERNANCE_CONTROL_PLANE_FALLBACK_TTL_SECONDS=300
export SUBAGENT_GOVERNANCE_CONTROL_PLANE_WARM_STABILITY_SECONDS=2
export SUBAGENT_GOVERNANCE_CONTROL_PLANE_WARM_STABILITY_POLL_SECONDS=1
export SUBAGENT_GOVERNANCE_CONTROL_PLANE_JAR="${DEVKIT_NATIVE_READINESS_GOVERNANCE_JAR:?}"
export SUBAGENT_GOVERNANCE_LATEST_JAR_PATH="${DEVKIT_NATIVE_READINESS_GOVERNANCE_JAR:?}"
export SUBAGENT_GOVERNANCE_REPO_CONFIG_PATH="$repo_config"
export SUBAGENT_GOVERNANCE_WORKSPACE_ID="$workspace_id"
export SUBAGENT_GOVERNANCE_KNOWN_WORKSPACE_IDS="$workspace_id"
export SUBAGENT_GOVERNANCE_WORKSPACE_ROOTS="${workspace_id}=${PWD}"

cleanup_governance() {
  scripts/devops/governance-control-plane stop >/dev/null 2>&1 || true
  rm -rf "$state_dir" "$attestation"
}
trap cleanup_governance EXIT

test -s "$SUBAGENT_GOVERNANCE_CONTROL_PLANE_JAR"
scripts/devops/governance-control-plane warm | tee "/tmp/devkit-governance-warm-agent${idx}.txt"
scripts/devops/governance-mcp-stdio-smoke --json | tee "/tmp/devkit-governance-stdio-agent${idx}.json"
grep -q '"ok": true' "/tmp/devkit-governance-stdio-agent${idx}.json"
echo "governance_agent_${idx}_ok"
EOF

step "parallel governance warm"
governance_pids=()
for idx in 1 2; do
  "$DEVKIT" -p dev-all exec "$idx" --repo "$REPO" --flake "$DEV_ALL_FLAKE" \
    --broker-socket "$broker_sock" --proxy-socket "$egress_sock" -- \
    env "DEVKIT_NATIVE_AUDIT_AGENT_INDEX=$idx" \
      "DEVKIT_NATIVE_READINESS_GOVERNANCE_JAR=$GOVERNANCE_JAR" \
      bash -lc "$governance_exec" \
    >"$audit_dir/governance-agent${idx}.txt" 2>&1 &
  governance_pids+=("$!")
done
for pid in "${governance_pids[@]}"; do
  wait "$pid"
done
for idx in 1 2; do
  cat "$audit_dir/governance-agent${idx}.txt"
  grep_required "healthy+stable at http://127.0.0.1:$((17880 + idx))" "$audit_dir/governance-agent${idx}.txt"
  grep_required "\"ok\": true" "$audit_dir/governance-agent${idx}.txt"
  grep_required "governance_agent_${idx}_ok" "$audit_dir/governance-agent${idx}.txt"
done

read -r -d '' codex_exec <<'EOF' || true
set -euo pipefail
idx="${DEVKIT_NATIVE_AUDIT_AGENT_INDEX:?}"
config="${CODEX_HOME:-$HOME/.codex}/config.toml"
mkdir -p "$(dirname "$config")"
if [[ -f "$config" ]] && grep -q '^model[[:space:]]*=[[:space:]]*"gpt-5\.3' "$config"; then
  echo "native-readiness-audit: Codex config has forbidden persistent gpt-5.3 default: $config" >&2
  exit 1
fi
expected_cwd="$(pwd -P)"
grep -Fq '# BEGIN DEVKIT NATIVE GOVERNANCE MCP' "$config" || {
  echo "native-readiness-audit: Codex governance config missing managed block: $config" >&2
  exit 1
}
grep -q '^\[mcp_servers\.governance\]$' "$config" || {
  echo "native-readiness-audit: Codex governance config missing governance MCP table: $config" >&2
  exit 1
}
grep -Fq 'command = "/run/current-system/sw/bin/bash"' "$config" || {
  echo "native-readiness-audit: Codex governance config has wrong command: $config" >&2
  exit 1
}
grep -Fq "cwd = \"$expected_cwd\"" "$config" || {
  echo "native-readiness-audit: Codex governance config has wrong cwd: $config expected=$expected_cwd" >&2
  exit 1
}
grep -Fq 'governance.workspace_topology' "$config" || {
  echo "native-readiness-audit: Codex governance config missing workspace_topology tool: $config" >&2
  exit 1
}

zsh -ic 'type codex; codex --version'
governance_env="/workspaces/dev/.devkit/ouro8-governance-env.sh"
test -r "$governance_env" || {
  echo "native-readiness-audit: generated governance env missing: $governance_env" >&2
  exit 1
}
# shellcheck disable=SC1090
source "$governance_env"
test -n "${DEVKIT_GOVERNANCE_EXPECTED_MCP_ENTRYPOINT_SHA256:-}" || {
  echo "native-readiness-audit: generated governance env missing expected entrypoint fingerprint: $governance_env" >&2
  exit 1
}
test -n "${DEVKIT_GOVERNANCE_MCP_ENTRYPOINT_SHA256:-}" || {
  echo "native-readiness-audit: generated governance env missing active entrypoint fingerprint: $governance_env" >&2
  exit 1
}
test "${DEVKIT_GOVERNANCE_MCP_ENTRYPOINT_SHA256}" = "${DEVKIT_GOVERNANCE_EXPECTED_MCP_ENTRYPOINT_SHA256}" || {
  echo "native-readiness-audit: generated governance env entrypoint fingerprint drift: $governance_env expected=$DEVKIT_GOVERNANCE_EXPECTED_MCP_ENTRYPOINT_SHA256 actual=$DEVKIT_GOVERNANCE_MCP_ENTRYPOINT_SHA256" >&2
  exit 1
}
printf '%s\n' "${SUBAGENT_GOVERNANCE_WORKSPACE_ROOTS:-}" | grep -Fq 'ouroboros-terraform=/workspaces/dev/ouroboros-terraform' || {
  echo "native-readiness-audit: generated governance env missing ouroboros-terraform workspace root: $governance_env" >&2
  exit 1
}
grep -q '^# governance_mcp_entrypoint_sha256 = ' "$config" || {
  echo "native-readiness-audit: Codex governance config missing entrypoint fingerprint stamp: $config" >&2
  exit 1
}
grep -q "^# governance_mcp_entrypoint_sha256 = \"${DEVKIT_GOVERNANCE_EXPECTED_MCP_ENTRYPOINT_SHA256}\"$" "$config" || {
  echo "native-readiness-audit: Codex governance config entrypoint fingerprint drift: $config expected=$DEVKIT_GOVERNANCE_EXPECTED_MCP_ENTRYPOINT_SHA256" >&2
  exit 1
}
grep -q 'DEVKIT_GOVERNANCE_MCP_ENTRYPOINT_SHA256=' "$config" || {
  echo "native-readiness-audit: Codex governance config missing entrypoint fingerprint export: $config" >&2
  exit 1
}
codex_output="/tmp/devkit-codex-agent${idx}.out"
codex exec -m "$CODEX_MODEL" "$CODEX_PROMPT" | tee "$codex_output"
tr -d '\r' < "$codex_output" | grep -qx 'ok' || {
  echo "native-readiness-audit: codex exec did not reply with exactly ok for agent ${idx}" >&2
  exit 1
}
bridge_provenance="${CODEX_HOME:-$HOME/.codex}/log/governance-mcp-stdio-forward/provenance.json"
test -r "$bridge_provenance" || {
  echo "native-readiness-audit: governance MCP bridge provenance missing after codex exec: $bridge_provenance" >&2
  exit 1
}
BRIDGE_PROVENANCE="$bridge_provenance" python3 - <<'PY'
import json
import os
import pathlib
import sys

path = pathlib.Path(os.environ["BRIDGE_PROVENANCE"])
payload = json.loads(path.read_text(encoding="utf-8"))
expected_jar_path = os.environ.get("DEVKIT_GOVERNANCE_EXPECTED_JAR_PATH", "")
expected_jar_sha = os.environ.get("DEVKIT_GOVERNANCE_EXPECTED_JAR_SHA256", "")
expected_repo_config_path = os.environ.get("DEVKIT_GOVERNANCE_REPO_CONFIG_PATH", "")
expected_repo_config_sha = os.environ.get("DEVKIT_GOVERNANCE_REPO_CONFIG_SHA256", "")
expected_entrypoint_sha = os.environ.get("DEVKIT_GOVERNANCE_EXPECTED_MCP_ENTRYPOINT_SHA256", "")

def require(condition: bool, message: str) -> None:
    if not condition:
        raise SystemExit(f"native-readiness-audit: {message}: {path}")

selected_jar_path = str(payload.get("selectedJarPath") or "")
selected_jar_sha = str(payload.get("selectedJarSha256") or "")
repo_config_path = str(payload.get("repoConfigPath") or "")
repo_config_sha = str(payload.get("repoConfigSha256") or "")
entrypoint_sha = str(payload.get("mcpEntrypointSha256") or "")

require(selected_jar_path.startswith("/nix/store/"), f"governance MCP bridge used non-Nix jar {selected_jar_path}")
require(bool(expected_jar_path) and selected_jar_path == expected_jar_path, f"governance MCP bridge jar path drift expected={expected_jar_path} actual={selected_jar_path}")
require(bool(expected_jar_sha) and selected_jar_sha == expected_jar_sha, f"governance MCP bridge jar SHA drift expected={expected_jar_sha} actual={selected_jar_sha}")
require(payload.get("jarMatchesExpected") is True, "governance MCP bridge did not report jar match")
require(bool(expected_repo_config_path) and repo_config_path == expected_repo_config_path, f"governance MCP bridge catalog path drift expected={expected_repo_config_path} actual={repo_config_path}")
require(bool(expected_repo_config_sha) and repo_config_sha == expected_repo_config_sha, f"governance MCP bridge catalog SHA drift expected={expected_repo_config_sha} actual={repo_config_sha}")
require(bool(expected_entrypoint_sha) and entrypoint_sha == expected_entrypoint_sha, f"governance MCP bridge entrypoint drift expected={expected_entrypoint_sha} actual={entrypoint_sha}")
require(payload.get("mcpEntrypointMatchesExpected") is True, "governance MCP bridge did not report entrypoint match")
PY
echo "codex_agent_${idx}_ok"
EOF

step "exact Codex command on both agents"
for idx in 1 2; do
  "$DEVKIT" -p dev-all exec "$idx" --repo "$REPO" --flake "$DEV_ALL_FLAKE" \
    --broker-socket "$broker_sock" --proxy-socket "$egress_sock" -- \
    env "DEVKIT_NATIVE_AUDIT_AGENT_INDEX=$idx" \
      "DEVKIT_NATIVE_READINESS_CODEX_MODEL=$CODEX_MODEL" \
      "CODEX_MODEL=$CODEX_MODEL" \
      "CODEX_PROMPT=$CODEX_PROMPT" \
      bash -lc "$codex_exec" \
    2>&1 | tee "$audit_dir/codex-agent${idx}.txt"
  grep_required "codex-cli $EXPECTED_CODEX_VERSION" "$audit_dir/codex-agent${idx}.txt"
  grep_required "model: $CODEX_MODEL" "$audit_dir/codex-agent${idx}.txt"
  grep_required "codex_agent_${idx}_ok" "$audit_dir/codex-agent${idx}.txt"
done

read -r -d '' backend_build_exec <<'EOF' || true
set -euo pipefail
scripts/sbt2 "project backend" "assembly"
jar="$(
  find target/out/jvm -path '*/backend/backend-*.jar' -type f -printf '%T@ %p\n' \
    | sort -n \
    | tail -1 \
    | cut -d' ' -f2-
)"
test -n "$jar"
test -s "$jar"
cp -f "$jar" target/devkit-backend.jar
test -s target/devkit-backend.jar
printf 'backend_jar=%s\n' "$jar"
printf 'backend_jar_size=%s\n' "$(wc -c < target/devkit-backend.jar)"
EOF

step "assemble backend jar inside native sandbox"
"$DEVKIT" -p dev-all exec 1 --repo "$REPO" --flake "$DEV_ALL_FLAKE" \
  --broker-socket "$broker_sock" -- \
  bash -lc "$backend_build_exec" \
  2>&1 | tee "$audit_dir/backend-build.txt"
grep_required "backend_jar=" "$audit_dir/backend-build.txt"
grep_required "backend_jar_size=" "$audit_dir/backend-build.txt"

read -r -d '' backend_launch_exec <<'EOF' || true
set -euo pipefail
test -s target/devkit-backend.jar
log="$(mktemp /tmp/devkit-backend-audit.XXXXXX.log)"
pid=""
cleanup_backend() {
  if [[ -n "$pid" ]]; then
    kill "$pid" >/dev/null 2>&1 || true
    wait "$pid" >/dev/null 2>&1 || true
  fi
  rm -f "$log"
}
trap cleanup_backend EXIT

PAYMENT_PROVIDER=square-mock \
OPEN_AI_API_KEY=placeholder-openai-key \
PASSWORD_RESET_SENDER_EMAIL=noreply@example.test \
PASSWORD_RESET_LINK_BASE_URL=http://127.0.0.1:8080/reset \
PASSWORD_RESET_SES_REGION=us-east-2 \
DOCUMENTS_S3_BUCKET=devkit-documents \
DOCUMENTS_S3_REGION=us-east-2 \
DEV_SEED_ACCOUNT=0 \
LOCAL_TSEC_INSECURE_COOKIE=1 \
java -cp target/devkit-backend.jar "${DEVKIT_NATIVE_READINESS_BACKEND_MAIN:?}" \
  >"$log" 2>&1 &
pid=$!

for _ in $(seq 1 90); do
  if ! kill -0 "$pid" >/dev/null 2>&1; then
    cat "$log" >&2 || true
    exit 1
  fi
  code="$(curl -sS -o /tmp/devkit-backend-root.out -w "%{http_code}" --connect-timeout 1 --max-time 2 http://127.0.0.1:8080/ || true)"
  if [[ "$code" = 404 ]]; then
    echo "backend_http_root=$code"
    echo "backend_jar_launch_ok"
    exit 0
  fi
  sleep 1
done

cat "$log" >&2 || true
echo "backend did not respond with expected HTTP 404 on /" >&2
exit 1
EOF

step "launch backend jar inside native sandbox"
"$DEVKIT" -p dev-all exec 1 --repo "$REPO" --flake "$DEV_ALL_FLAKE" \
  --broker-socket "$broker_sock" --proxy-socket "$egress_sock" -- \
  env "DEVKIT_NATIVE_READINESS_BACKEND_MAIN=$BACKEND_MAIN" \
    bash -lc "$backend_launch_exec" \
  2>&1 | tee "$audit_dir/backend-launch.txt"
grep_required "backend_http_root=404" "$audit_dir/backend-launch.txt"
grep_required "backend_jar_launch_ok" "$audit_dir/backend-launch.txt"

step "native down"
"$DEVKIT" -p dev-all down --repo "$REPO" --count 2 \
  --flake "$DEV_ALL_FLAKE" \
  --broker-socket "$broker_sock" \
  --broker-state-root "$broker_state" \
  --format json \
  | tee "$audit_dir/down.json"
grep_required '"running": false' "$audit_dir/down.json"

echo
echo "native-readiness-audit: ok"
