#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
DEVKIT_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd -P)"
DEVKIT="$DEVKIT_ROOT/kit/scripts/devkit"

overlays=(
  _template
  codex
  dev-all
  dumb-onion-hax
  ouro-integration
  ouroboros-static-front-end
  ouroboros-terraform
  pokeemerald
)

fail() {
  echo "native-overlay-matrix: $*" >&2
  exit 1
}

step() {
  printf '\n== %s ==\n' "$*"
}

grep_required() {
  local pattern="$1"
  local file="$2"
  grep -q -- "$pattern" "$file" || fail "missing expected pattern $pattern in $file"
}

yaml_section_scalar() {
  local yaml="$1"
  local section="$2"
  local key="$3"
  awk -v section="$section" -v key="$key" '
    /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
    /^[^[:space:]][^:]*:[[:space:]]*$/ {
      current = $0
      sub(/:.*/, "", current)
      next
    }
    current == section && $0 ~ "^[[:space:]]+" key ":[[:space:]]*" {
      sub("^[[:space:]]+" key ":[[:space:]]*", "")
      sub(/[[:space:]]+#.*$/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      if ((substr($0, 1, 1) == "\"" && substr($0, length($0), 1) == "\"") ||
          (substr($0, 1, 1) == "'"'"'" && substr($0, length($0), 1) == "'"'"'")) {
        $0 = substr($0, 2, length($0) - 2)
      }
      print
      exit
    }
  ' "$yaml"
}

expected_shell_for() {
  case "$1" in
    _template) echo "template-agent" ;;
    *) echo "$1" ;;
  esac
}

default_repo_for() {
  local overlay="$1"
  local yaml="$DEVKIT_ROOT/overlays/$overlay/devkit.yaml"
  local repo
  repo="$(yaml_section_scalar "$yaml" defaults repo)"
  if [[ -n "$repo" ]]; then
    echo "$repo"
    return
  fi
  if [[ "$overlay" == "dev-all" ]]; then
    echo "ouroboros-ide"
    return
  fi
  echo "$overlay"
}

runtime_flake_for() {
  local overlay="$1"
  local yaml="$DEVKIT_ROOT/overlays/$overlay/devkit.yaml"
  yaml_section_scalar "$yaml" runtime flake
}

matrix_dir="$(mktemp -d /tmp/devkit-native-overlay-matrix.XXXXXX)"

cleanup() {
  set +e
  for overlay in "${overlays[@]}"; do
    local_repo="$(default_repo_for "$overlay" 2>/dev/null || true)"
    sock="$matrix_dir/$overlay/broker.sock"
    state="$matrix_dir/$overlay/broker-state"
    [[ -n "$local_repo" ]] || local_repo="$overlay"
    "$DEVKIT" -p "$overlay" down --repo "$local_repo" --count 1 \
      --broker-socket "$sock" --broker-state-root "$state" \
      --format json >/dev/null 2>&1 || true
  done
  rm -rf "$matrix_dir"
}
trap cleanup EXIT

printf 'OVERLAY\tREPO\tFLAKE\tSHELL\tRESULT\n'

for overlay in "${overlays[@]}"; do
  flake="$(runtime_flake_for "$overlay")"
  [[ -n "$flake" ]] || fail "$overlay missing runtime.flake"
  expected="./overlays/$overlay#default"
  [[ "$flake" == "$expected" ]] || fail "$overlay runtime.flake=$flake, want $expected"

  repo="$(default_repo_for "$overlay")"
  shell="$(expected_shell_for "$overlay")"
  overlay_dir="$matrix_dir/$overlay"
  workroot="$overlay_dir/worktrees"
  stateroot="$overlay_dir/agents"
  sock="$overlay_dir/broker.sock"
  state="$overlay_dir/broker-state"
  mkdir -p "$workroot/agent1/$repo" "$stateroot"

  step "$overlay up/status/exec/down"
  "$DEVKIT" -p "$overlay" up --repo "$repo" --count 1 \
    --flake "$flake" \
    --skip-prepare --skip-ready \
    --broker-socket "$sock" \
    --broker-state-root "$state" \
    --worktree-root "$workroot" \
    --agent-state-root "$stateroot" \
    --format json \
    | tee "$overlay_dir/up.json"
  grep_required '"command": "up"' "$overlay_dir/up.json"
  grep_required '"runtime": "native"' "$overlay_dir/up.json"
  grep_required '"running": true' "$overlay_dir/up.json"

  "$DEVKIT" -p "$overlay" status --repo "$repo" --count 1 \
    --flake "$flake" \
    --broker-socket "$sock" \
    --broker-state-root "$state" \
    --worktree-root "$workroot" \
    --agent-state-root "$stateroot" \
    --format json \
    | tee "$overlay_dir/status.json"
  grep_required '"command": "status"' "$overlay_dir/status.json"
  grep_required '"runtime": "native"' "$overlay_dir/status.json"

  "$DEVKIT" -p "$overlay" exec 1 --repo "$repo" \
    --flake "$flake" \
    --broker-socket "$sock" \
    --worktree-root "$workroot" \
    --agent-state-root "$stateroot" \
    -- \
    env "EXPECTED_SHELL=$shell" "EXPECTED_BROKER=unix://$sock" \
      bash -lc '
        set -euo pipefail
        test "${DEVKIT_NATIVE_AGENT:-}" = 1
        test "${DEVKIT_NIX_SHELL:-}" = "$EXPECTED_SHELL"
        test "${DOCKER_HOST:-}" = "$EXPECTED_BROKER"
        test ! -e /var/run/docker.sock
        command -v codex >/dev/null
        codex --version
        printf "overlay=%s shell=%s repo=%s\n" "$EXPECTED_SHELL" "$DEVKIT_NIX_SHELL" "$(basename "$PWD")"
      ' \
    2>&1 | tee "$overlay_dir/exec.txt"
  grep_required "shell=$shell" "$overlay_dir/exec.txt"
  grep_required "codex-cli" "$overlay_dir/exec.txt"

  "$DEVKIT" -p "$overlay" down --repo "$repo" --count 1 \
    --flake "$flake" \
    --broker-socket "$sock" \
    --broker-state-root "$state" \
    --worktree-root "$workroot" \
    --agent-state-root "$stateroot" \
    --format json \
    | tee "$overlay_dir/down.json"
  grep_required '"command": "down"' "$overlay_dir/down.json"
  grep_required '"runtime": "native"' "$overlay_dir/down.json"
  grep_required '"running": false' "$overlay_dir/down.json"

  printf '%s\t%s\t%s\t%s\tok\n' "$overlay" "$repo" "$flake" "$shell"
done

if find "$DEVKIT_ROOT/overlays" -maxdepth 2 -name flake.lock -print | grep -q .; then
  fail "overlay-local Nix checks created flake.lock files"
fi

printf '\nnative-overlay-matrix: ok\n'
